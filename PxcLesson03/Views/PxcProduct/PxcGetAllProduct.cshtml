
@{
	ViewData["Title"] = "Danh sách  sản phẩm";
	var products = ViewData["products"] as List<PxcLesson03.Models.pxcproduct>;
}
<div class="card">
	<div class="class-header">
		<h1>@ViewData["Title"]</h1>
	</div>
	<div class="card-body">
		<table class="table table-bordered">
			<thead>
				<tr>
					<th>ID</th>
					<th>Name</th>
					<th>Year</th>
					<th>Price</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				@foreach(var item in products)
				{
					<tr>
						<td>@item.pxcproductId</td>
						<td>@item.pxcproductName</td>
						<td>@item.YearRelease</td>
						<td>@item.Price</td>
						<td>
							<a href="#" class="btn btn-info">Xem Chi Tiết</a>
							<a href="#" class="btn btn-primary">Sửa </a>
							<a href="#" class="btn btn danger">Xóa</a>
						</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr>
					<th colspan="5">TỔng số sản phẩm: @products.Count</th>
				</tr>
			</tfoot>
		</table>
	</div>
</div>