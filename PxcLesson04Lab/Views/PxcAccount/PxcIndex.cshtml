@using PxcLesson04Lab.Models
@{
    ViewData["Title"] = "Danh sách tài khoản";
    var pxcAccounts = ViewBag.PxcAccounts as List<PxcAccount>;
}

<h2 class="my-3">@ViewData["Title"]</h2>

<div class="row">
    @if (pxcAccounts != null)
    {
        @foreach (var item in pxcAccounts)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@item.Avatar" class="card-img-top" alt="@item.Name" style="height: 220px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text">@item.Bio</p>
                        </div>
                        <a asp-route="PxcProfile" asp-route-id="@item.Id" class="btn btn-success w-100 mt-3">Profile</a>
                    </div>
                </div>
            </div>
        }
    }
</div>