@model PxcLesson08Models.Models.PxcMembers

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>PxcMembers</h4>
<hr />
<form asp-action="PxcEdit" method="post">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PxcMembersId" class="form-label fw-bold"></label>
                <input asp-for="PxcMembersId" class="form-control" placeholder="Nhập mã thành viên..." />
                <span asp-validation-for="PxcMembersId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PxcUserName" class="form-label fw-bold"></label>
                <input asp-for="PxcUserName" class="form-control" placeholder="Nhập tên đăng nhập..." />
                <span asp-validation-for="PxcUserName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PxcPassword" class="form-label fw-bold"></label>
                <input asp-for="PxcPassword" type="password" class="form-control" placeholder="Nhập mật khẩu..." />
                <span asp-validation-for="PxcPassword" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PxcFullname" class="form-label fw-bold"></label>
                <input asp-for="PxcFullname" class="form-control" placeholder="Nhập họ và tên..." />
                <span asp-validation-for="PxcFullname" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="PxcEmail" class="form-label fw-bold"></label>
                <input asp-for="PxcEmail" class="form-control" placeholder="example@domain.com" />
                <span asp-validation-for="PxcEmail" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="card-footer bg-light d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Cập nhật
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            Quay lại danh sách
        </a>
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
