@model IEnumerable<PxcLesson08Models.Models.PxcMembers>

@{
    ViewData["Title"] = "Danh sách thành viênnnn";
}
<div class="card p-3">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="PxcCreate">Thêm Mới</a>
    </div>

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.PxcUserName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PxcPassword)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PxcFullname)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PxcEmail)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(model => item.PxcUserName)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.PxcPassword)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.PxcFullname)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.PxcEmail)
                        </td>
                        <td>
                            @Html.ActionLink("Sửa", "PxcEdit", new { id = item.PxcMembersId }) |
                            @Html.ActionLink("Xem chi tiết", "PxcDetails", new { id = item.PxcMembersId }) |
                            @Html.ActionLink("Xóa", "PxcDelete", new { id = item.PxcMembersId })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
</div>
</div>
